FROM rust:1.82 as builder

WORKDIR /workspace

# Create the workspace structure up-front for cached dependency resolution.
RUN mkdir -p rust/kosh-core/src rust/kosh-api/src rust/kosh-cli/src \
    && echo '// placeholder' > rust/kosh-core/src/lib.rs \
    && echo '// placeholder' > rust/kosh-api/src/lib.rs \
    && echo 'fn main() {}' > rust/kosh-cli/src/main.rs

# Pre-copy Cargo manifests to leverage build caching for dependency fetching.
COPY rust/Cargo.toml rust/Cargo.lock ./rust/
COPY rust/kosh-core/Cargo.toml rust/kosh-core/Cargo.toml
COPY rust/kosh-api/Cargo.toml rust/kosh-api/Cargo.toml
COPY rust/kosh-cli/Cargo.toml rust/kosh-cli/Cargo.toml

RUN cd rust && cargo fetch --locked

# Copy the full workspace and build the release binary.
COPY rust ./rust
RUN cd rust && cargo build --locked --release -p kosh-cli

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --uid 1000 --create-home kosh

COPY --from=builder /workspace/rust/target/release/kosh-cli /usr/local/bin/kosh

WORKDIR /var/lib/kosh
USER kosh

ENTRYPOINT ["kosh"]
